---
interface Props {
  passwordHash: string;
  targetId: string;
  storageKey?: string;
}

const { passwordHash, targetId, storageKey = "post-unlock" } = Astro.props as Props;
---

<div id={storageKey} data-hash={passwordHash ?? ''} data-target={targetId ?? 'article'} data-storage={storageKey} class="pw-modal fixed inset-0 z-50 flex items-center justify-center bg-black/50">
  <div class="pw-box w-full max-w-md rounded bg-card p-6 shadow-lg">
    <h3 class="mb-2 text-lg font-semibold">Protected post</h3>
    <p class="mb-4 text-sm text-muted">Enter the password to view this post.</p>
    <div class="flex gap-2">
      <input id={`${storageKey}-input`} class="flex-1 rounded border px-3 py-2" type="password" placeholder="Password" />
      <button type="button" id={`${storageKey}-submit`} class="rounded bg-accent px-4 py-2 text-white">Unlock</button>
    </div>
    <p id={`${storageKey}-error`} class="mt-2 text-sm text-red-500" style="display:none">Incorrect password</p>
  </div>
</div>

<style>
  .pw-modal { backdrop-filter: blur(12px); }
</style>

<script is:inline data-storage={storageKey}>
  (async () => {
    function hex(buffer) {
      return Array.from(new Uint8Array(buffer)).map(b => b.toString(16).padStart(2, '0')).join('');
    }

    async function sha256(text) {
      const enc = new TextEncoder();
      const data = enc.encode(text);
      const digest = await crypto.subtle.digest('SHA-256', data);
      return hex(digest);
    }

    // Locate the modal by ID. The script tag includes the storage key in a data attribute.
    const scriptEl = document.currentScript;
    const storageKeyFromScript = scriptEl ? scriptEl.getAttribute('data-storage') : null;
    const storageKeyFromDOM = storageKeyFromScript || 'post-unlock';
    const modal = document.getElementById(storageKeyFromDOM);
    // Read server-provided props from data-attributes on the modal
    const hashHex = modal?.dataset?.hash || '';
    const targetId = modal?.dataset?.target || 'article';

    

    const input = modal ? modal.querySelector(`#${CSS.escape(storageKeyFromDOM)}-input`) : null;
    const submit = modal ? modal.querySelector(`#${CSS.escape(storageKeyFromDOM)}-submit`) : null;
    const err = modal ? modal.querySelector(`#${CSS.escape(storageKeyFromDOM)}-error`) : null;

    function reveal() {
      const target = document.getElementById(targetId);
      if (target) target.style.display = '';
      if (modal) modal.remove();
    }

    // try {
    //   if (sessionStorage.getItem(storageKeyFromDOM) === 'true') {
    //     reveal();
    //     return;
    //   }
    // } catch (e) {}

    

    if (submit) {
      submit.addEventListener('click', async () => {
        const val = (input && input.value) || '';
      const h = await sha256(val);
      if (h === hashHex) {
        try {
          sessionStorage.setItem(storageKeyFromDOM, 'true');
        } catch (e) {}
        reveal();
      } else {
        if (err) err.style.display = 'block';
      }
      });
    } else {
    }

    // allow Enter key
    if (input) {
      input.addEventListener('keydown', (ev) => {
        if (ev && ev.key === 'Enter') {
          submit && submit.dispatchEvent(new Event('click'));
        }
      });
    }
  })();
</script>
